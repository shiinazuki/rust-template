#!/usr/bin/env bash
# 提交前的**快速**检查：只跑跟本次改动相关的那几项。
#
# 分工（三层，越往后越慢、越全）：
#   pre-commit  格式化 / clippy / 拼写 / 私钥          ← 本文件，秒级
#   pre-push    just ci = lint + test + audit          ← 全量，推送前
#   CI          再跑一遍，外加 hack / msrv / semver 等
#
# 为什么不在这里跑测试：提交是本地动作，做到一半的活儿也该能存档。每次 commit
# 都等一遍全量测试，最后只会让人养成 --no-verify 的习惯——那才是真的失去防线。
#
# ⚠️ 检查的是**工作区**当前状态，不是暂存区快照。`git commit -a` 下两者一致；
#    用 `git add -p` 做部分暂存时，未暂存的改动也会被算进来。
#    （要精确只检查暂存内容，得先 stash 掉未暂存的改动再恢复——那是个经典的
#      丢代码来源，不值得为这点精度冒险。）
#
# 安装：just hooks        临时跳过：git commit --no-verify
set -euo pipefail

# 模板仓库自身跑不了 cargo（Cargo.toml 里还是占位符），直接放行。
# ⚠️ 本文件在 cargo-generate.toml 的 exclude 列表里，不做变量替换 ——
#    下面这个占位符必须原样保留。
if grep -qF '{{ project-name }}' Cargo.toml 2>/dev/null; then
    exit 0
fi

# 本次提交涉及哪些文件（A 新增 / C 复制 / M 修改 / R 改名，不含删除）
changed=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$changed" ]; then
    exit 0
fi

touched() { printf '%s\n' "$changed" | grep -qE "$1"; }
fail=0

run() {
    local label=$1
    shift
    printf '  → %s\n' "$label"
    "$@" || fail=1
}

# --- 私钥 -------------------------------------------------------------------
# 这一条不看文件类型，只看新增的行。原来由 pre-commit 的 detect-private-key 负责，
# 是整套钩子里唯一「一旦漏掉就无法挽回」的检查：密钥一旦进了 git 历史，
# 删文件是没用的，得重写历史 + 作废密钥。
if git diff --cached -U0 -- . \
    | grep -qE '^\+.*-----BEGIN ([A-Z]+ )?PRIVATE KEY( BLOCK)?-----'; then
    echo "✗ 暂存的改动里出现了私钥（-----BEGIN ... PRIVATE KEY-----）" >&2
    echo "  密钥一旦进入 git 历史就删不干净，必须现在拦下。" >&2
    fail=1
fi

# --- Rust 源码 --------------------------------------------------------------
if touched '\.rs$'; then
    # rustfmt.toml 用了 unstable 选项，stable 的 rustfmt 会静默忽略，必须走 nightly
    run "cargo +nightly fmt --check" cargo +nightly fmt --all -- --check
    run "cargo clippy" cargo clippy --all-targets --all-features -- -D warnings
fi

# --- TOML -------------------------------------------------------------------
# taplo 默认会把「读到了哪份配置、扫了哪十几个文件」全部按 INFO 打出来，在钩子里
# 是纯噪音。RUST_LOG=warn 压掉 INFO，ERROR（也就是真的没格式化好）照常显示，
# 退出码不受影响。
if touched '\.toml$' && command -v taplo >/dev/null 2>&1; then
    run "taplo fmt --check" env RUST_LOG=warn taplo fmt --check
fi

# --- 依赖 -------------------------------------------------------------------
# 只在依赖图真的可能变了的时候跑：cargo deny 要解析整棵依赖树，
# 改一行注释就跑一遍纯属浪费。
if touched '(Cargo\.(toml|lock)|deny\.toml)$'; then
    run "cargo deny check" cargo deny check
fi

# --- 拼写 -------------------------------------------------------------------
# typos 扫全仓也就几十毫秒，不必按文件类型筛
if command -v typos >/dev/null 2>&1; then
    run "typos" typos
fi

if [ "$fail" -ne 0 ]; then
    {
        echo
        echo "✗ 提交前检查未通过。"
        echo "  多数格式问题可以直接修：just fmt / just fix"
        echo "  确实要先存档：git commit --no-verify"
        echo
        echo "  这里刻意只跑快的那几项；测试与依赖审计在 pre-push（just ci）那一层。"
    } >&2
    exit 1
fi
