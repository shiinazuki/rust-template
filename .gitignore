/target
/dist
**/*.rs.bk
*.pdb

# 覆盖率 / 测试报告产物
/coverage
lcov.info
junit.xml
*.profraw
*.profdata

# 性能分析产物
flamegraph.svg
perf.data*
profile.json

# 本地环境变量。最后一行是个惯例性的例外：不加的话，哪天你写了一份
# .env.example 想提交给同事参考，会被上一行悄悄忽略掉，还很难看出原因。
.env
.env.*
!.env.example

# 合并冲突残留
*.orig
*.rej

# GitLab CI 把 CARGO_HOME 指到工程目录下（只有工程目录能进 cache），
# 本地用 gitlab-runner 跑流水线时会留下这个目录
/.cargo-home

# 编辑器 / 操作系统。编辑器的本地配置一律不进版本库——各人用的编辑器不一样，
# 而且里面多半有只在自己机器上成立的路径。
.DS_Store
.idea/
.vscode/
.zed/
*.swp
*~
*.log
