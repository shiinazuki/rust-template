# 构建上下文越小，docker build 越快。target/ 动辄好几个 G，务必排除。
target/
.git/
.github/
.gitlab-ci.yml
.idea/
.devcontainer/
scripts/
# 项目级 cargo 配置刻意不带进容器：里面多半是只在宿主机成立的设置（指定 mold
# 链接器、镜像源、nightly 才认的 -Zthreads），带进去轻则不生效、重则让构建直接失败。
# 代价是 [net] retry 那类无害设置在容器里也用不上——需要的话在这里放行它。
.cargo/

# 容器里用不到的开发期文件
*.md
!README.md
.pre-commit-config.yaml
cliff.toml
deny.toml
release.toml
bacon.toml
.taplo.toml
.typos.toml
justfile
docker.just
.editorconfig
.gitattributes
.gitignore
Dockerfile
.dockerignore

# 本地产物与密钥
lcov.info
junit.xml
flamegraph.svg
perf.data*
coverage/
.env
.env.*
!.env.example
