# 构建上下文越小，docker build 越快。target/ 动辄好几个 G，务必排除。
target/
.git/
.github/
.gitlab-ci.yml
.idea/
.devcontainer/
scripts/
# 以后若加了项目级 cargo 配置：里面多半是只在宿主机成立的设置（比如指定 mold
# 链接器），带进容器会让构建直接失败
.cargo/

# 容器里用不到的开发期文件
*.md
!README.md
.pre-commit-config.yaml
cliff.toml
deny.toml
release.toml
bacon.toml
.taplo.toml
.typos.toml
justfile
docker.just
.editorconfig
.gitattributes
.gitignore
Dockerfile
.dockerignore

# 本地产物与密钥
lcov.info
junit.xml
flamegraph.svg
perf.data*
coverage/
.env
.env.*
!.env.example
