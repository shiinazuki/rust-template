// Dev Container：一键还原开发环境（VS Code Dev Containers / GitHub Codespaces）。
// 说明见 https://containers.dev/
{
  "name": "{{ project-name }}",
  // 官方 Rust 镜像，自带 rustup / cargo / git / 常用编译依赖。
  // 具体用哪个工具链由仓库里的 rust-toolchain.toml 决定，见下面的 postCreateCommand。
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",

  "features": {
    // just 是本项目的命令入口
    "ghcr.io/guiyomh/features/just:0": {}
  },

  // 容器建好之后跑一次：按 rust-toolchain.toml 装工具链，再装配套 cargo 工具。
  // 用 binstall 直接下预编译二进制，比源码编译快一个数量级。
  "postCreateCommand": "rustup show active-toolchain || rustup toolchain install && cargo install cargo-binstall && just install-tools",

  "customizations": {
    "vscode": {
      // 和 .vscode/extensions.json 保持一致
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "usernamehw.errorlens",
        "fill-labs.dependi",
        "skellock.just"
      ]
    }
  },

  // 容器内不要用 root 干活：文件属主会和宿主机对不上，而且没必要。
  "remoteUser": "vscode"
}
